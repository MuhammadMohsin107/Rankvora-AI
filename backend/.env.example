# Copy to .env and fill in. Keep the KEYS here in sync with .env — a key added to one and not
# the other is how a deploy fails on a variable nobody noticed was missing. Values are expected
# to differ: this file documents, .env holds real credentials and is never committed.

NODE_ENV=development
PORT=5000

# OPTIONAL. Which proxy hops the API believes when it works out a caller's address — the address the
# sign-in rate limits are counted against. In production the API sits behind an edge proxy and
# frontend/server.cjs, so every request arrives from 127.0.0.1; the default, loopback, reads the
# real client from X-Forwarded-For and cannot be spoofed by a caller's own header. Leave it unset
# unless your proxies are not on loopback. Accepts false, a hop count (2), or addresses/ranges
# (10.0.0.0/8). "true" is refused: it would let any caller choose their own rate-limit bucket.
# TRUST_PROXY=loopback

# The local SQLite database file, for running the API with Node on this machine (npm run dev,
# npm run db:migrate, the verify:* scripts). The app's database is SQLite: Cloudflare D1 in
# production, where it comes from the D1 binding in wrangler.jsonc and this setting is not used.
# Created on first use; run `npm run db:migrate` to build its tables. Tests ignore it and always
# use a throwaway in-memory database.
DATABASE_PATH=./local.db

# When true (and NODE_ENV is not production), authenticate() returns before it ever reads the
# Authorization header and treats EVERY request as user id 1 — all protected endpoints become
# open. Real Shopify sign-in works now, so this defaults to false; turn it on only for deliberate
# local work where you do not want to hold a token, and never where real accounts exist.
MOCK_AUTH=false

# Secret that signs the short-lived `state` carried through the Shopify and Google OAuth redirects (the
# app issues no session token of its own — Shopify ID tokens prove who is calling). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Generate fresh values per environment; never reuse a development secret in production.
JWT_ACCESS_SECRET=

# ─── Shopify ──────────────────────────────────────────────────────────────────
# Credentials from your Shopify Partner app (Partner Dashboard → Apps → your app → Client
# credentials). Optional: until all four Shopify-related values below are set, /api/shopify/*
# returns a clear 500 (SHOPIFY_NOT_CONFIGURED) and the Integrations page hides Connect. The rest
# of the API is unaffected.
#
# SECRET is server-side only. It must never appear in a VITE_* variable, in frontend code, or in
# any API response — it is what signs and verifies every OAuth callback, webhook and Shopify ID token.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# The redirect URL (${BACKEND_URL}/api/shopify/callback), the app/uninstalled and app/scopes_update
# webhooks and the three mandatory privacy webhooks are declared in shopify.app.toml at the repository
# root and released with `shopify app deploy`. Nothing is registered at install time, and nothing needs
# adding by hand in the Partner Dashboard.
#
# Both URLs must be reachable by a browser, and must match the environment this .env belongs to —
# staging URLs in a local .env send a local OAuth flow to the deployed site.
# Local:    http://localhost:5000  /  http://localhost:5173
# Deployed: the one public origin for both. The API is reached at /api on that same origin
#           (server.cjs proxies it), so there is no api. subdomain.
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# 32-byte hex key used to encrypt stored Shopify access and refresh tokens (AES-256-GCM).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this makes every stored token undecryptable — merchants would have to reconnect.
TOKEN_ENCRYPTION_KEY=

# ─── Google Search Console ───────────────────────────────────────────
# OAuth client credentials from https://console.cloud.google.com → APIs & Services → Credentials
# → Create OAuth client ID → Web application.
#
# Optional at startup, like the Shopify block: without it the API runs normally and the
# Integrations page shows Search Console as unavailable rather than offering a Connect button with
# nothing behind it.
#
# ONE OAuth client serves BOTH Search Console and Google Analytics — one consent screen, one
# token pair, two APIs. There is no second set of credentials for Analytics.
#
# SETUP, IN ORDER — all three are required or the consent screen fails:
#   1. Enable these APIs for the project (APIs & Services → Library):
#        Google Search Console API      searchconsole.googleapis.com
#        Google Analytics Data API      analyticsdata.googleapis.com    (GA4 reports)
#        Google Analytics Admin API     analyticsadmin.googleapis.com   (listing GA4 properties)
#      Both Analytics APIs are needed: the Data API cannot enumerate properties, so without the
#      Admin API a merchant would have to paste a numeric id by hand — and a typo would silently
#      report another company's traffic as this store's.
#   2. Add this EXACT redirect URI to the OAuth client:
#        ${BACKEND_URL}/api/google/callback
#      e.g. https://scorelo-staging.tlxapps.com/api/google/callback
#      Google matches it character for character — a trailing slash or http vs https is a mismatch,
#      and it is rejected before Rankvora AI is ever called.
#   3. On the OAuth consent screen, add these scopes:
#        https://www.googleapis.com/auth/webmasters.readonly
#        https://www.googleapis.com/auth/analytics.readonly
#        https://www.googleapis.com/auth/userinfo.email
#      Read-only is the whole grant: Rankvora AI reads performance and changes nothing. The writable
#      `.../auth/webmasters` and `.../auth/analytics` are deliberately NOT requested, and the test
#      suite fails the build if either appears in the source.
#
# ADDING A SCOPE LATER IS NOT FREE. Google issues scopes only on fresh consent, so every merchant
# connected before a scope was added keeps a token without it and must reconnect. The GA4 code
# checks the stored grant and asks for a reconnect rather than failing at Google with a 403.
#
# While the consent screen is in "Testing", only accounts listed as test users can connect.
#
# TOKEN_ENCRYPTION_KEY above is also required for this integration — the refresh token Google
# returns is a long-lived credential to a merchant's search data and is encrypted at rest.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── AI recommendations (optional) ───────────────────────────────────
# Server-side only. NEVER prefix with VITE_ and never expose to the browser:
# the frontend calls Rankvora AI, and Rankvora AI calls the model provider.
# Leave blank to run Rankvora AI with deterministic recommendations only.
#
# Which vendor serves AI requests: 'openai' (default when unset) or 'gemini'.
AI_PROVIDER=openai
#
# ── Gemini ────────────────────────────────────────────────────────────
# Google AI Studio key — free tier available at https://aistudio.google.com.
# GEMINI_API_KEY is accepted as an alias, since that is the name Google's own examples use.
AI_API_KEY=
# Defaults to gemini-flash-lite-latest, which returns schema-shaped JSON in about a second.
# Gemini 3 "thinking" models can spend the whole output budget before writing an answer.
AI_MODEL=gemini-flash-lite-latest
#
# ── OpenAI ────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# Cost-efficient default when unset. Override per environment.
OPENAI_MODEL=gpt-4o-mini
#
# Kill switch that works even when a key is present. Set to false to stop all AI calls.
AI_RECOMMENDATIONS_ENABLED=true
#
# ── AI product images (Missing images panel: "Generate with AI") ─────────────────────────────
# Drawing a picture is a different capability from writing text, and a key that writes text often
# cannot draw: Google's image models have NO free tier, and OpenAI's image models need a verified
# organization. When the key cannot draw, the panel says so and asks for the AI key to be updated.
# Which vendor draws: 'openai' or 'gemini'. Defaults to AI_PROVIDER, using that vendor's key above.
AI_IMAGE_PROVIDER=
# Defaults: openai -> gpt-image-2.5-flare, gemini -> gemini-3.1-flash-image. Cheaper Gemini option:
# gemini-3.1-flash-lite-image. Any model the key can use works.
AI_IMAGE_MODEL=
# Ceiling on ONE drawing, in ms. Keep it under the proxy's read timeout (nginx default 60s).
AI_IMAGE_TIMEOUT_MS=55000
# Kill switch for drawing alone (uploads from a computer are unaffected).
AI_IMAGE_ENABLED=true

# ─── Storefront crawler (optional) ───────────────────────────────────
# Bounds on the only part of Rankvora AI that requests pages from a merchant's live storefront.
# Defaults are production-safe; raise them only if you understand the load it puts on a shop.
CRAWL_ENABLED=true
CRAWL_MAX_PAGES=40
CRAWL_TIMEOUT_MS=12000
CRAWL_CONCURRENCY=3
CRAWL_USER_AGENT=ScoreloAuditBot/1.0 (+https://scorelo.app/bot)
# Only for a store still behind Shopify's "Restrict access" password gate. Without it a gated
# storefront yields no rendered evidence and every crawl-based check reports "not measured".
# Never commit a real value.
CRAWL_STOREFRONT_PASSWORD=

# ─── Complete link scan (optional) ───────────────────────────────────
# Loads EVERY page of a store and requests EVERY link on them (the store's and other websites'), in batches.
# Defaults suit the Workers Paid plan and a Node server; on the Workers FREE plan (50 queries and 50 outgoing
# requests per step) lower both batch sizes to about 5 and 20, or use Paid.
# LINK_SCAN_ENABLED=true            # kill switch: the button, the API and the scan after each analysis
# LINK_SCAN_AUTO=true               # start a scan when an analysis finishes
# LINK_SCAN_AUTO_MIN_HOURS=6        # ...but not more often than this per store
# LINK_SCAN_MAX_URLS=30000          # distinct addresses per scan; past it the scan says part of the store was left out
# LINK_SCAN_BATCH_PAGES=40          # pages loaded per batch (one Workflow step)
# LINK_SCAN_BATCH_CHECKS=120        # link targets requested per batch
# LINK_SCAN_EXTERNAL_CONCURRENCY=8  # requests to other websites at once (never more than 2 to one site)
# LINK_SCAN_EXTERNAL_TIMEOUT_MS=10000
# LINK_SCAN_STUCK_MS=1800000        # a scan with no heartbeat for this long is closed out as failed

# ─── Background work on this server (optional) ──────────────────────
# All three are ON when unset — right while this server is the only thing running audits.
# On go-live day for Cloudflare, set all three to false on the OLD server and restart it, so it does
# no background work at all while Cloudflare runs the audits, the schedules and the stuck-job sweep.
# AUTO_ANALYSIS_ENABLED=true      # scheduled re-analysis sweep, every 30 minutes
# WEEKLY_SUMMARY_ENABLED=true     # Monday weekly-summary sweep
# FAIL_INTERRUPTED_JOBS=true      # at start-up, mark queued/running audit jobs as failed
