.dev.vars
.dev.vars.*
.wrangler/

# Local SQLite databases (DATABASE_PATH, e.g. backend/local.db) and the files SQLite keeps beside them.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

